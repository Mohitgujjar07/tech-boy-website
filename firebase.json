{
  "hosting": [
    {
      "site": "aarambhx-tech",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        ".git/**",
        ".github/**",
        "**/.*",
        "node_modules/**",
        "**/node_modules/**",
        "tests/**",
        "scripts/**",
        "scratch/**",
        "*.log",
        "**/*.log",
        "*.bat",
        "**/*.bat",
        "*.ps1",
        "**/*.ps1",
        "*.cmd",
        "**/*.cmd",
        "*.sh",
        "**/*.sh",
        "*.exe",
        "**/*.exe",
        "server.js",
        "package.json",
        "package-lock.json"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "redirects": [
        {
          "source": "/developer",
          "destination": "/academy",
          "type": 301
        },
        {
          "source": "/developer.html",
          "destination": "/academy.html",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/google6cf729a5f661a4ef.html",
          "destination": "/google6cf729a5f661a4ef.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-XSS-Protection",
              "value": "1; mode=block"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        },
        {
          "source": "assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "admin*",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, max-age=0"
            }
          ]
        }
      ]
    },
